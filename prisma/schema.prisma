generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id // UUID from Supabase auth.users
  email     String   @unique
  name      String?
  role      String   @default("customer")
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String?
  image            String?
  group            CategoryGroup     @default(NONE)
  productCategories ProductCategory[]
  createdAt        DateTime          @default(now())
}

model Product {
  id               String                  @id @default(cuid())
  name             String
  slug             String                  @unique
  description      String
  // Price stored in ARS cents (e.g. 24900 = $249.00 ARS)
  price            Int
  comparePrice     Int?
  images           String[]
  colors           String[]                @default([])
  sizes            String[]                @default([])
  categories       ProductCategory[]
  stock            Int                     @default(0)
  featured         Boolean                 @default(false)
  featuredOrder    Int?
  active           Boolean                 @default(true)
  brand            Brand                   @default(OTROS)
  supplier         Supplier?
  weightKg         Float?
  shippingMethods  ProductShippingMethod[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([featured, active])
  @@index([brand])
}

model ProductShippingMethod {
  productId        String
  shippingMethodId String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  shippingMethod   ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)

  @@id([productId, shippingMethodId])
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId, isPrimary])
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

// Session-based cart — no user account required
model CartItem {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  size      String?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@unique([sessionId, productId, size])
}

// ─── Shipping ─────────────────────────────────────────────────────────────────

model ShippingMethod {
  id                     String                  @id @default(cuid())
  name                   String
  description            String?
  baseWeightKg           Float
  baseCostUsd            Float
  additionalCostPerKgUsd Float
  additionalUnitKg       Float
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  orders                 Order[]
  products               ProductShippingMethod[]
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  email     String
  status          OrderStatus @default(PENDING)
  trackingNumber  String?
  subtotal        Int
  shipping        Int
  total           Int
  shippingMethodId String?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  shippingBreakdown Json?
  items           OrderItem[]
  address         Address?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([email])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Int
  quantity  Int
  size      String?
  color     String?

  @@index([orderId])
}

// ─── Address ──────────────────────────────────────────────────────────────────

model Address {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  street  String
  city    String
  state   String
  zipCode String
  country String
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Brand {
  NIKE
  JORDAN
  ADIDAS
  OTROS
}

enum Supplier {
  GM
  KIT
  S23
  ADJ
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CategoryGroup {
  ROPA
  ACCESORIOS
  NONE
}

// ─── Site Config ──────────────────────────────────────────────────────────────

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
